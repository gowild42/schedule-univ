rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isOwner(code) {
      return isTeacher() &&
        get(/databases/$(database)/documents/classes/$(code)).data.ownerUid == request.auth.uid;
    }

    match /classes/{code} {
      allow get: if signedIn();
      allow list: if isTeacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.ownerUid == request.auth.uid;

      match /events/{id} {
        allow read: if signedIn();
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/classes/$(code))
          && request.resource.data.keys().hasOnly(['date','univ','type'])
          && request.resource.data.univ is string && request.resource.data.univ.size() <= 20;
        allow delete: if isOwner(code);
      }

      // 학생 이름: 학생은 쓰기만 가능, 읽기는 해당 학급 교사만 가능
      match /names/{id} {
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/classes/$(code))
          && request.resource.data.keys().hasOnly(['name'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 10;
        allow read, delete: if isOwner(code);
      }
    }
  }
}
